rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    function isAuthenticated() {
      return request.auth != null;
    }

    function isAdmin() {
      return isAuthenticated() && request.auth.token.role == 'admin';
    }

    function isManager() {
      return isAuthenticated() && request.auth.token.role == 'manager';
    }

    function isEmployee() {
      return isAuthenticated() && request.auth.token.role == 'employee';
    }

    function isOwner(userId) {
      return isAuthenticated() && request.auth.uid == userId;
    }

    // Works for Managers AND Employees — both can hold home + temp dept access
    function hasDepartmentAccess(deptId) {
      return isAdmin() || (
        isAuthenticated() &&
        (request.auth.token.homeDeptId == deptId || deptId in request.auth.token.tempDeptIds)
      );
    }

    function isEntityNotLocked() {
      return !('isPendingDeletion' in resource.data) || resource.data.isPendingDeletion != true;
    }


    match /departments/{deptId} {
      allow read: if isAuthenticated();
      allow write: if isAdmin();
    }

    match /users/{userId} {
      // CORRECTED: Employees can only read their own doc, not the whole
      // company directory. Admin/Manager keep full read.
      allow read: if isAdmin() || isManager() || isOwner(userId);

      allow create: if isAdmin() || (
        isManager() &&
        request.resource.data.role in ['employee', 'manager'] &&
        hasDepartmentAccess(request.resource.data.homeDepartmentId)
      );

      allow update: if isEntityNotLocked() && (
        isAdmin() || (
          isManager() &&
          resource.data.role == 'employee' &&
          hasDepartmentAccess(resource.data.homeDepartmentId) &&
          !request.resource.data.diff(resource.data).affectedKeys()
            .hasAny(['role', 'homeDepartmentId', 'temporaryDepartmentIds'])
        )
      );

      allow delete: if false;
    }

    match /clients/{clientId} {
      allow read: if isAuthenticated();
      allow create: if isAdmin() || isManager();

      allow update: if isEntityNotLocked() && (
        isAdmin() || (
          isManager() &&
          resource.data.createdBy == request.auth.uid &&
          !request.resource.data.diff(resource.data).affectedKeys().hasAny(['createdBy'])
        )
      );

      allow delete: if false;
    }

    match /tickets/{ticketId} {
      allow read: if isAdmin() ||
        (isManager() && hasDepartmentAccess(resource.data.departmentId)) ||
        (isEmployee() && resource.data.assignedToId == request.auth.uid);

      allow create: if isAdmin() || (
        isManager() && hasDepartmentAccess(request.resource.data.departmentId)
      );

      allow update: if isEntityNotLocked() && (
        (resource.data.status != 'completed' && (
          isAdmin() ||
          (isManager() &&
            hasDepartmentAccess(resource.data.departmentId) &&
            hasDepartmentAccess(request.resource.data.departmentId))
        )) ||
        (
          resource.data.assignedToId == request.auth.uid &&
          request.resource.data.diff(resource.data).affectedKeys().hasOnly(['status', 'updatedAt'])
        )
      );

      allow delete: if false;
    }

    match /tickets/{ticketId}/comments/{commentId} {
      // canReadTicket: mirrors the parent ticket's read rule exactly.
      // Defined inline via get() since Firestore rules functions cannot reference
      // a sibling/parent document without get().
      // Admin always; Manager with dept access; Employee only if they're the assignee.
      allow read: if isAdmin() ||
        (isManager() && hasDepartmentAccess(get(/databases/$(database)/documents/tickets/$(ticketId)).data.departmentId)) ||
        (isEmployee() && get(/databases/$(database)/documents/tickets/$(ticketId)).data.assignedToId == request.auth.uid);

      // Create: anyone who can READ the parent ticket may also post a comment.
      // This is intentionally the same condition as allow read above.
      allow create: if isAdmin() ||
        (isManager() && hasDepartmentAccess(get(/databases/$(database)/documents/tickets/$(ticketId)).data.departmentId)) ||
        (isEmployee() && get(/databases/$(database)/documents/tickets/$(ticketId)).data.assignedToId == request.auth.uid);

      // Comments are immutable — no editing or deleting.
      allow update, delete: if false;
    }

    match /tickets/{ticketId}/history/{entryId} {
      // Read access mirrors the parent ticket's read rule exactly.
      allow read: if isAdmin() ||
        (isManager() && hasDepartmentAccess(get(/databases/$(database)/documents/tickets/$(ticketId)).data.departmentId)) ||
        (isEmployee() && get(/databases/$(database)/documents/tickets/$(ticketId)).data.assignedToId == request.auth.uid);

      // History is ONLY written by Cloud Function triggers — no client-side writes.
      allow create, update, delete: if false;
    }

    match /deletionRequests/{requestId} {
      allow read: if isAdmin() || (isManager() && resource.data.requestedByUid == request.auth.uid);
      allow create: if isManager() && request.resource.data.requestedByUid == request.auth.uid;
      // CORRECTED: no client-side path to approve/reject — Cloud Functions only.
      allow update, delete: if false;
    }
  }
}

rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    
    // ─── Helpers ─────────────────────────────────────────────────────────────
    
    // Check if the user is authenticated
    function isAuthenticated() {
      return request.auth != null;
    }

    // Check if the user has the 'manager' role in their custom claims
    function isManager() {
      return isAuthenticated() && request.auth.token.role == 'manager';
    }

    // Check if the user has the 'employee' role in their custom claims
    function isEmployee() {
      return isAuthenticated() && request.auth.token.role == 'employee';
    }

    // Check if the user is the owner of the document
    function isOwner(userId) {
      return isAuthenticated() && request.auth.uid == userId;
    }
    
    // Ensure that only the allowed fields are present in the request
    function onlyAllowedFields(allowedFields) {
      return request.resource.data.keys().hasOnly(allowedFields);
    }

    // ─── Collections ─────────────────────────────────────────────────────────

    match /users/{userId} {
      // Any authenticated user can read user documents (e.g. to see names/avatars)
      allow read: if isAuthenticated();
      // Only managers can create/update users (or Cloud Functions using Admin SDK)
      allow create, update: if isManager();
      allow delete: if false; // Soft delete via 'status' field instead
    }

    match /clients/{clientId} {
      // Any authenticated user can read client documents
      allow read: if true;
      // Only managers can create/update clients
      allow create, update, delete: if isManager();
    }

    // Check if only specific fields are being modified in an update
    function onlyAffectedFields(allowedFields) {
      return request.resource.data.diff(resource.data).affectedKeys().hasOnly(allowedFields);
    }

    match /tickets/{ticketId} {
      // Managers can read all tickets. Employees can only read tickets assigned to them.
      allow read: if isManager() || (isEmployee() && resource.data.assignedToId == request.auth.uid);
      
      // Only Managers can create tickets
      allow create: if isManager();
      
      // Managers can update any ticket.
      // Employees can update tickets assigned to them, but ONLY the status and updatedAt fields.
      allow update: if isManager() || (
        isEmployee() &&
        resource.data.assignedToId == request.auth.uid &&
        onlyAffectedFields(['status', 'updatedAt'])
      );
      
      allow delete: if false;
    }
  }
}
